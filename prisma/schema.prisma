generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Analysis {
  id             Int      @id @default(autoincrement())

  company         String
  symbol          String
  exchange        String

  price           Float?
  currency        String?

  marketCap       Float?
  peRatio         Float?
  eps             Float?

  recommendation  String
  confidence      String

  riskLevel       String
  riskScore       Int

  searchedAt      DateTime @default(now())
}